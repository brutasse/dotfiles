[user]
	email = brutasse@users.noreply.github.com
	name = Bruno Renié

[github]
	user = brutasse
	name = brutasse

[alias]
	ci = commit
	st = status -bs
	di = diff
	whatchanged = log --raw --no-merges

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[core]
	excludesfile = ~/.gitignore

[credential]
	helper = store
[rebase]
	autosquash = true
[commit]
	gpgsign = true
[diff]
	noprefix = true
	colorMoved = default
[pull]
	rebase = false
[init]
	defaultBranch = main
# when gh supports ssh key verification
#[gpg]
#	format = ssh
#[gpg "ssh"]
#	defaultKeyCommand = ssh-add -L
#	allowedSignersFile = /home/brute/.ssh/allowed_signers
[push]
	default = simple
	autoSetupRemote = true
[url "git@github.com:"]
	insteadOf = https://github.com/
[protocol "file"]
	allow = always
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
